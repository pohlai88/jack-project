# =============================================================================
# Managed local environment source
# =============================================================================
# Copy this file to `env.config` and maintain that file locally.
# Do not edit `.env.local` directly; it is generated from `env.config`.
#
# After editing `env.config`, run:
#   pnpm env:sync
# =============================================================================

# -----------------------------------------------------------------------------
# Minimum scaffold variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Afenda
DATABASE_URL=postgresql://afenda:afenda@localhost:5432/afenda_dev
# Optional direct connection for migrations / DDL if your provider exposes one
# DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=development-secret-change-in-production-min32chars
ENABLE_AI_FEATURES=false

# -----------------------------------------------------------------------------
# Optional runtime flags
# -----------------------------------------------------------------------------
# Next.js manages NODE_ENV itself; do not set it in env.config
# NEXT_PUBLIC_STAGE=dev
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Optional auth
# -----------------------------------------------------------------------------
# AUTH_URL=http://localhost:3000
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_ISSUER=https://your-tenant.auth0.com

# -----------------------------------------------------------------------------
# Optional AI / LLM providers
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Optional storage / observability
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=afenda-uploads
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=afenda-uploads
# S3_REGION=us-east-1
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# GITHUB_INTEGRATION_CLIENT_ID=
# GITHUB_INTEGRATION_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
