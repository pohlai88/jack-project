# =============================================================================
# Managed local environment source
# =============================================================================
# Copy this file to `env.config` and maintain that file locally.
# Do not edit `.env.local` directly; it is generated from `env.config`.
#
# After editing `env.config`, run:
#   pnpm env:sync
#
# That refreshes `.env.local` (dev) and `.env.production` (production merge + URL overrides).
# Compare Production readiness: `pnpm vercel:env:report`
# =============================================================================

# -----------------------------------------------------------------------------
# Minimum scaffold variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Afenda
DATABASE_URL=postgresql://afenda:afenda@localhost:5432/afenda_dev
# Optional direct connection for migrations / DDL if your provider exposes one
# DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=development-secret-change-in-production-min32chars
ENABLE_AI_FEATURES=false
# Allow signed-in users with no tenant membership to create their first org (select-tenant).
ENABLE_SELF_SERVICE_TENANT_CREATE=false
# Verified custom apex hostname → tenant (admin DNS TXT flow); default off.
ENABLE_CUSTOM_DOMAIN=false
# Proxy Host→tenant rewrite via GET /api/internal/tenant-by-host (requires MIDDLEWARE_TENANT_LOOKUP_SECRET).
ENABLE_CUSTOM_DOMAIN_ROUTING=false
# Shared bearer secret for internal tenant-by-host lookup (min 32 chars when routing is enabled).
# MIDDLEWARE_TENANT_LOOKUP_SECRET=

# -----------------------------------------------------------------------------
# Optional runtime flags
# -----------------------------------------------------------------------------
# Next.js manages NODE_ENV itself; do not set it in env.config
# NEXT_PUBLIC_STAGE=dev
# LOG_LEVEL=debug
# PDF_HOST=http://localhost:3000
# PDF_DOCS_DIR=content/i18n/docs
# PDF_OUT_DIR=.artifacts/docs-pdf
# PUPPETEER_CACHE_DIR=.artifacts/puppeteer

# -----------------------------------------------------------------------------
# Optional auth
# -----------------------------------------------------------------------------
# Canonical origin for Auth.js (redirect_uri, email links). With tenant subdomains,
# keep this on ONE host (usually apex or app host), not per-tenant URLs.
# AUTH_URL=https://app.example.com
# AUTH_URL=http://localhost:3000
#
# Optional shared cookie Domain for Auth.js when using tenant subdomains.
# If unset, TENANT_ROOT_DOMAIN is used (then NEXT_PUBLIC_* fallbacks on server).
# Chrome allows Domain=localhost for *.localhost dev (e.g. acme.localhost:3000).
# AUTH_COOKIE_DOMAIN=example.com
#
# Client-visible cookie domain (next-intl NEXT_LOCALE + aligned client config).
# These are PUBLIC (bundled in browser JS), not secrets — deploy-time only; change requires rebuild/redeploy.
# Set NEXT_PUBLIC_TENANT_ROOT_DOMAIN to the SAME value as TENANT_ROOT_DOMAIN when using subdomains,
# OR set NEXT_PUBLIC_COOKIE_DOMAIN to the apex hostname used for Set-Cookie Domain (wins over public tenant root).
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN=localhost
# NEXT_PUBLIC_COOKIE_DOMAIN=example.com
#
# Auth0 Dashboard → Application → URLs (examples for AUTH_URL=https://app.example.com):
#   Allowed Callback URLs:  https://app.example.com/api/auth/callback/auth0
#   Allowed Logout URLs:      https://app.example.com
#   Allowed Web Origins:      https://app.example.com
# Local: add http://localhost:3000/api/auth/callback/auth0 etc. when AUTH_URL is localhost.
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_ISSUER=https://your-tenant.auth0.com

# -----------------------------------------------------------------------------
# Production — nexuscanon.com (Vercel)
# -----------------------------------------------------------------------------
# Reference: architecture/governance/evidence/tenants/TENANT_SUBDOMAIN_VERCEL_DNS.md
# Tenant apps: https://{slug}.nexuscanon.com — set TENANT_ROOT_DOMAIN to the registrable apex label only.
# Canonical app + Auth.js origin (www): OAuth callback URLs must match AUTH_URL exactly.
#
# Copy into env.config and Vercel → Production (non-secret keys only here; DATABASE_URL/AUTH_SECRET in secrets):
# NEXT_PUBLIC_APP_URL=https://www.nexuscanon.com
# AUTH_URL=https://www.nexuscanon.com
# TENANT_ROOT_DOMAIN=nexuscanon.com
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN=nexuscanon.com
# Shared cookies across www + tenant subdomains (ADR 0008 — same apex label, no dot prefix):
# AUTH_COOKIE_DOMAIN=nexuscanon.com
# NEXT_PUBLIC_COOKIE_DOMAIN=nexuscanon.com
#
# Auth0 (if used): Allowed Callback https://www.nexuscanon.com/api/auth/callback/auth0 (logout/web origins on www).

# -----------------------------------------------------------------------------
# Optional AI / LLM providers
# -----------------------------------------------------------------------------
# AI_GATEWAY_API_KEY=vck_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Optional storage / observability
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=afenda-uploads
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=afenda-uploads
# S3_REGION=us-east-1
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# -----------------------------------------------------------------------------
# Optional multi-tenant host (subdomain → /[locale]/t/[slug] rewrite in src/proxy.ts)
# -----------------------------------------------------------------------------
# Root label only (no scheme). Matches Host suffix .{TENANT_ROOT_DOMAIN} for tenant slug.
# Local: use TENANT_ROOT_DOMAIN=localhost and open http://acme.localhost:3000 (hosts file not required).
# Production nexuscanon.com: see "Production — nexuscanon.com" above (also set NEXT_PUBLIC_* mirrors).
# When TENANT_ROOT_DOMAIN is set, set NEXT_PUBLIC_TENANT_ROOT_DOMAIN to the same value so
# NEXT_LOCALE shares Set-Cookie Domain across subdomains (see Optional auth above).
# TENANT_ROOT_DOMAIN=localhost
# TENANT_ROOT_DOMAIN=nexuscanon.com

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# GITHUB_INTEGRATION_CLIENT_ID=
# GITHUB_INTEGRATION_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional Tolgee (ops TMS — see ADR-0010 / TOLGEE_INTEGRATION.md)
# -----------------------------------------------------------------------------
# CI: same key as GitHub Actions repository secret TOLGEE_API_KEY for workflow tolgee-i18n.yml (optional).
# Min: TOLGEE_API_KEY (or PROJECT_API_KEY / TOLGEE_PERSONAL_ACCESS_TOKEN — mapped by tolgee-load-env).
# Cloud defaults api base in CLI; add TOLGEE_API_URL only if self-hosted.
# TOLGEE_API_KEY=
# PROJECT_API_KEY=
# TOLGEE_PERSONAL_ACCESS_TOKEN=
# TOLGEE_PROJECT_ID=
# TOLGEE_API_URL=
# TOLGEE_CLI_FORMAT=
# TOLGEE_BRANCH=
# Local dev in-context UI only (never production key in browser):
# NEXT_PUBLIC_TOLGEE_API_URL=http://localhost:8080
# NEXT_PUBLIC_TOLGEE_DEV_ENABLED=true
