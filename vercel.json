{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/search/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/assistant/conversations/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/assistant/conversations/[id]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/integrations/github/callback/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/integrations/github/connect/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/integrations/github/user-connect/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/tenants/[tenant]/admin/integrations/conflicts/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/tenants/[tenant]/admin/integrations/metrics/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/tenants/[tenant]/admin/integrations/readiness/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/tenants/[tenant]/admin/integrations/runs/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/tenants/[tenant]/admin/integrations/github/org-members/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/tenants/[tenant]/admin/integrations/github/assign-usernames/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/tenants/[tenant]/admin/settings/ai/test/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/tenants/[tenant]/admin/settings/storage/test/route.ts": {
      "maxDuration": 60
    },
    "src/app/(docs-meta)/llms-full.txt/route.ts": {
      "maxDuration": 60
    },
    "src/app/(docs-meta)/llms.mdx/[locale]/docs/[[...slug]]/route.ts": {
      "maxDuration": 60
    }
  }
}
