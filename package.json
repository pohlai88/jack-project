    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "eslint . --report-unused-disable-directives --max-warnings 0",
    "repo:guard": "node scripts/repo-guard.mjs",
    "type-check": "fumadocs-mdx && tsc --noEmit",
    "doctrine:check": "node scripts/check-doctrine.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:fallback-check": "node scripts/i18n-fallback-check.mjs",
    "i18n:check": "pnpm i18n:validate",
    "i18n:inventory:check": "node scripts/i18n-inventory-check.mjs",
