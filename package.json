    "i18n:tolgee:ci": "node scripts/tolgee-ci.mjs",
    "docs:contract": "tsx scripts/docs-evidence-pipeline.ts contract",
    "docs:inventory": "tsx scripts/docs-evidence-pipeline.ts inventory",
    "docs:generate": "tsx scripts/docs-evidence-pipeline.ts generate",
    "docs:source": "fumadocs-mdx",
    "fumadocs": "pnpm exec fumadocs",
    "fumadocs:add": "pnpm exec fumadocs add",
    "fumadocs:customize": "pnpm exec fumadocs customise",
    "fumadocs:tree": "pnpm exec fumadocs tree",
    "docs:links": "tsx scripts/docs-validate-links.ts",
    "docs:llms": "pnpm docs:source && tsx scripts/docs-evidence-pipeline.ts llms",
    "docs:pdf:setup": "node scripts/with-env-config.mjs puppeteer browsers install chrome",
    "docs:pdf": "pnpm docs:source && node scripts/with-env-config.mjs tsx scripts/export-pdf.mts",
    "docs:search": "tsx scripts/docs-evidence-pipeline.ts search-site && pagefind --site .artifacts/docs-search-site --output-path public/_pagefind && tsx scripts/docs-evidence-pipeline.ts search-check",
    "docs:check": "tsx scripts/docs-evidence-pipeline.ts check",
    "docs:ci": "pnpm docs:contract && pnpm docs:inventory -- --check && pnpm docs:generate -- --check && pnpm docs:source && pnpm docs:links && pnpm docs:llms && pnpm docs:check && pnpm type-check && pnpm test && pnpm build && pnpm docs:search",
    "prepare": "husky",
    "test": "node scripts/with-env-config.mjs vitest run --passWithNoTests",
    "test:watch": "node scripts/with-env-config.mjs vitest --passWithNoTests",
    "test:coverage": "node scripts/with-env-config.mjs vitest run --coverage --passWithNoTests",
    "db:generate": "node scripts/with-env-config.mjs drizzle-kit generate",
    "db:migrate": "node scripts/with-env-config.mjs drizzle-kit migrate",
    "db:push": "echo \"db:push is not reliable with this non-public schema setup; running db:migrate instead.\" && pnpm db:migrate",
    "db:push:unsafe": "node scripts/with-env-config.mjs drizzle-kit push --force",
    "db:studio": "node scripts/with-env-config.mjs drizzle-kit studio",
    "db:seed": "node scripts/with-env-config.mjs tsx scripts/seed-demo.ts",
    "db:reset": "node scripts/with-env-config.mjs tsx scripts/db-reset.ts",
    "db:fresh": "pnpm db:reset --force && pnpm db:seed",
    "embeddings:generate": "node scripts/with-env-config.mjs tsx scripts/generate-embeddings.ts",
    "embeddings:recreate": "node scripts/with-env-config.mjs tsx scripts/generate-embeddings.ts --recreate",
    "storybook": "node scripts/with-env-config.mjs storybook dev -p 6006",
    "build-storybook": "node scripts/with-env-config.mjs storybook build",
    "deploy:vercel:production": "pnpm run build && pnpm exec vercel deploy --prod --yes --scope jacks-projects-7b3cfe94",
    "vercel:link": "vercel link --yes --scope jacks-projects-7b3cfe94 --project afenda-node",
    "vercel:project": "vercel project inspect afenda-node --scope jacks-projects-7b3cfe94",
    "vercel:env:production": "vercel env ls production --scope jacks-projects-7b3cfe94",
    "vercel:env:push-production": "node scripts/push-vercel-production-env.mjs",
    "vercel:env:report": "node scripts/show-production-env-status.mjs",
    "vercel:domain:remove-apex": "node scripts/remove-vercel-apex-domain.mjs",
    "vercel:deployments": "vercel ls --scope jacks-projects-7b3cfe94"
  },
